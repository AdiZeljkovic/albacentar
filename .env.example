# Kopirajte u .env.local i popunite.

# Javna adresa stranice (bez kose crte na kraju). Koristi se za sitemap, Open Graph i kanonske linkove.
NEXT_PUBLIC_SITE_URL=https://albacentar.hr

# Dok je "false" (ili prazno), stranica šalje noindex i robots.txt brani indeksiranje.
# Postavite na "true" tek kad stranica ide uživo na pravoj domeni.
SITE_INDEXABLE=false

# Slanje upita s obrazaca (prijava na radionicu, konzultacije, knjige, kontakt) ide preko Resend API-ja.
# Bez ovih vrijednosti obrasci u razvoju samo ispisuju upit u konzolu, a u produkciji javljaju grešku
# i upućuju posjetitelja na e-mail, da se nijedan upit ne izgubi "u tišini".
RESEND_API_KEY=
# Adresa na koju stižu upiti.
UPITI_EMAIL_TO=info@albacentar.hr
# Pošiljatelj (domena mora biti verificirana u Resendu).
UPITI_EMAIL_FROM=AlBa Centar <web@albacentar.hr>
